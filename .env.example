# Copie ce fichier en ".env" et remplis TES informations toi-meme.
# Ne jamais mettre .env dans un commit git ou le partager.

# Ton NIP FABER (numero d'immatriculation candidat)
DISPOWEB_NIP=

# Ta date de naissance au format JJ.MM.AAAA (comme affiche sur le site)
DISPOWEB_BIRTHDAY=

# Categorie de permis (moto = A, a confirmer via --discover)
DISPOWEB_CATEGORIE=A

# idGroupeExamen / genre / type d'examen : a recuperer avec --discover
# une fois connecte au moins une fois manuellement dans le navigateur.
DISPOWEB_ID_GROUPE_EXAMEN=
DISPOWEB_GENRE=
DISPOWEB_TYPE=

# id du/des lieux d'examen a surveiller, separes par virgule (vide = tous)
DISPOWEB_LIEUX=

# Intervalle de scan en secondes (reste raisonnable, ex: 180-300)
DISPOWEB_POLL_INTERVAL=240

# Horizon maximum fiable en semaines (au-dela, le site n'a pas encore ouvert
# la fenetre de reservation et l'API peut renvoyer des donnees trompeuses)
DISPOWEB_MAX_WEEKS_AHEAD=17

# Semaines revues a chaque cycle - mets la meme valeur que MAX_WEEKS_AHEAD
# pour scanner tout l'horizon fiable a chaque fois
DISPOWEB_NEAR_WEEKS=4

# true = tente de reserver automatiquement des qu'un creneau apparait
# false = notifie seulement, tu reserves toi-meme en 1 clic
DISPOWEB_AUTO_BOOK=false
